<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: center; width: auto; height: auto; top: 0; left: 0; bottom: 0; right: 0; position: relative; flex-direction: column;">
        <ui:Label text="Label" name="HpLabel" style="width: 200px; height: 100px; font-size: 30px; -unity-text-align: middle-center;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="HpPercentText" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:Label text="Label" name="LevelLabel" style="height: 100px; width: 200px; font-size: 30px; -unity-text-align: middle-center;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="LevelText" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:ProgressBar value="22" title="my-progress" name="HpProgressBar" style="height: 50px; width: 300px;">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="HpSliderValue" binding-mode="ToTarget"/>
            </Bindings>
        </ui:ProgressBar>
        <ui:ProgressBar value="22" title="my-progress" name="ExpProgressBar" style="width: 300px; height: 50px;">
            <Bindings>
                <ui:DataBinding property="value" data-source-path="ExpSliderValue" binding-mode="ToTarget"/>
            </Bindings>
        </ui:ProgressBar>
        <ui:Button text="Button" name="DamageButton" style="width: 200px; height: 50px;"/>
    </ui:VisualElement>
</ui:UXML>
