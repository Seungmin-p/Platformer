<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Slot" style="flex-grow: 1; background-color: rgb(0, 0, 0); width: 100px; height: 100px; margin-right: 6px; margin-bottom: 6px;">
        <ui:VisualElement name="Item-Icon" picking-mode="Ignore" style="flex-grow: 1; position: absolute; top: 4px; right: 4px; bottom: 4px; left: 4px; background-color: rgb(67, 67, 67);">
            <ui:Label text="99" name="Item-Count" picking-mode="Ignore" style="font-size: 25px; color: rgb(255, 255, 255); -unity-text-outline-color: rgba(0, 0, 0, 0.37); -unity-text-outline-width: 0; width: 15px; height: 15px; -unity-text-align: middle-center; position: absolute; bottom: 8px; right: 8px; -unity-font-style: normal; text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.92);">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="AmountText" binding-mode="ToTarget"/>
                    <ui:DataBinding property="style.display" data-source-path="AmountVisible" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
            <Bindings>
                <ui:DataBinding property="style.backgroundImage" data-source-path="IconSprite" binding-mode="ToTarget"/>
                <ui:DataBinding property="style.unityBackgroundImageTintColor" data-source-path="IconTint" binding-mode="ToTarget"/>
            </Bindings>
        </ui:VisualElement>
        <ui:VisualElement name="Item-Highlight" picking-mode="Ignore" style="flex-grow: 0; position: absolute; top: 2px; left: 2px; bottom: 2px; right: 2px; flex-direction: column;"/>
    </ui:VisualElement>
</ui:UXML>
